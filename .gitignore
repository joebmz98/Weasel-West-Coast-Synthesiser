# --- OS / editor junk ---
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# --- KiCad ---
# automatic backups and autosaves
*-backups/
_autosave-*
*.bak
*.bck
*.kicad_pcb-bak
*.sch-bak
\#auto_saved_files#
# lock files created while a board/schematic is open
*.lck
~*.lck
# local caches and per-user view settings
fp-info-cache
*.kicad_prl
# Fabrication Toolkit backup archives (current production files stay tracked)
**/production/backups/

# --- Arduino / PlatformIO / build output ---
build/**/*.elf
build/**/*.hex
*.bin
*.map
.pio/
.pioenvs/
.piolibdeps/
# Arduino IDE build folders: ignore everything in them except the exported .hex
# (Sketch > Export Compiled Binary), so a release build can be committed
src/**/build/**
!src/**/build/**/
!src/**/build/**/*.ino.hex

# --- Python ---
__pycache__/
*.pyc
tools/button_test/gen.h
tools/button_test/button_test
